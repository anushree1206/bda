# Environment
APP_ENV=development
DATASET_PATH=data/household_power_consumption_sample.txt

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=smart-meter-readings
KAFKA_CONSUMER_GROUP=energy-forecasting-group

# Hadoop HDFS Configuration
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_USER=hadoop
STORAGE_BACKEND=local

# Forecasting Configuration
FORECAST_MODEL=prophet
FORECAST_HORIZON_HOURS=24
DATABASE_URL=sqlite:///./data/energy_forecasting.db

# API Host
VITE_API_BASE_URL=http://localhost:8000
